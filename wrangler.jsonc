{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appsepehr4",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "465fbcb9-74de-4d49-b845-a7d7a1ef7c8f","database_name": "Sepehr4" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1cc0e872d1d44db8a05d70833bfa845b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
